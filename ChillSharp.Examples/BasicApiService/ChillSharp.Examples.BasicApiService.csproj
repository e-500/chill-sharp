  <ItemGroup>
    <PackageReference Include="ChillSharp" Version="1.0.0" />
    <PackageReference Include="ChillSharp.Client" Version="1.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.22" />
  </ItemGroup>

</Project>
