# ASP.NET Core hosting
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Development

# Core ChillSharp API
CHILLSHARP_DB_PATH=/data/blogging.db
CHILLSHARP_PRIMARY_CULTURE=en-GB
CHILLSHARP_SECONDARY_CULTURE=it-IT
CHILLSHARP_API_PROTECTED=true
CHILL_SHARP_SYSTEM_TIMEZONE=Europe/Rome

# Optional ChillSharp modules
CHILLSHARP_ENABLE_SCHEMA=true
CHILLSHARP_ENABLE_AUTH=true
CHILLSHARP_ENABLE_I18N=true
CHILLSHARP_ENABLE_MCP=true
CHILLSHARP_ENABLE_ATTACHMENT=false

# ChillSharp.Attachment archive storage
CHILLSHARP_ATTACHMENT_ARCHIVE_ROOT=/attachments

# ChillSharp.Auth behavior
CHILLSHARP_AUTH_ACCESS_TOKEN_MINUTES=20
CHILLSHARP_AUTH_REFRESH_TOKEN_DAYS=14
CHILLSHARP_AUTH_RETURN_PASSWORD_RESET_TOKENS=false
CHILLSHARP_AUTH_SEND_PASSWORD_RESET_EMAILS=true
CHILLSHARP_AUTH_INITIALIZE_ROOT_USER=true
CHILLSHARP_AUTH_CREATE_ROOT_AUTH_USER=true
CHILLSHARP_AUTH_PASSWORD_RESET_SUBJECT=Reset your password
CHILLSHARP_AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# SMTP delivery for password-reset emails
CHILLSHARP_SMTP_HOST=smtp.example.com
CHILLSHARP_SMTP_PORT=587
CHILLSHARP_SMTP_ENABLE_SSL=true
CHILLSHARP_SMTP_USERNAME=no-reply@example.com
CHILLSHARP_SMTP_PASSWORD=change-me
CHILLSHARP_SMTP_FROM_EMAIL=no-reply@example.com
CHILLSHARP_SMTP_FROM_DISPLAY_NAME=ChillSharp No-Reply

# Root bootstrap account for ChillSharp.Auth
CHILLSHARP_AUTH_ROOT_USERNAME=root
CHILLSHARP_AUTH_ROOT_PASSWORD=Pass123$
CHILLSHARP_AUTH_ROOT_EMAIL=root@example.com
CHILLSHARP_AUTH_ROOT_DISPLAY_NAME=Root Administrator
