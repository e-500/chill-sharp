{
  "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
  "dest": "dist",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "*.js",
      "input": "service-worker",
      "output": "service-worker"
    },
    {
      "glob": "**/*",
      "input": "src/styles",
      "output": "styles"
    }
  ],
  "allowedNonPeerDependencies": [
    "@chill-sharp/ng-client",
    "@chill-sharp/ts-client",
    "monaco-editor",
    "tslib"
  ]
}
