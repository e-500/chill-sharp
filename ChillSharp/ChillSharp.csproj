<Project Sdk="Microsoft.NET.Sdk">
	
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Library</OutputType>
        <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
        <Title>ChillSharp</Title>
	        <Copyright>© 2025 Andrea Piovesan</Copyright>
        <PackageIcon>logo.png</PackageIcon>
        <RepositoryUrl>https://github.com/e-500/chill-sharp</RepositoryUrl>
        <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IsPackable>true</IsPackable>
        <Description>ChillSharp is a powerful .NET library designed to streamline the management of complex data models and accelerate the development of web APIs. Built on top of Entity Framework Core, ChillSharp abstracts the complexity of database interactions while providing a lightweight, web-friendly layer for querying, creating, updating, and deleting entities through Data Transfer Objects (DTOs).</Description>
        <Version>1.0.132</Version>
        <Authors>Andrea Piovesan</Authors>
        <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeBuiltinModuleOutputs</TargetsForTfmSpecificBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\logo\logo.png">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <None Include="..\ChillSharp.Template\.agents\skills\**\*">
            <Pack>True</Pack>
            <PackagePath>.agents\skills\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <ProjectReference Include="..\ChillSharp.Schema.Abstractions\ChillSharp.Schema.Abstractions.csproj" PrivateAssets="all" />
	    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.27" />
	    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
	    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
	    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    </ItemGroup>

    <Target Name="BuildBuiltinModuleProjects">
        <MSBuild Projects="$(MSBuildProjectDirectory)\..\ChillSharp.Schema.Abstractions\ChillSharp.Schema.Abstractions.csproj;$(MSBuildProjectDirectory)\..\ChillSharp.Auth\ChillSharp.Auth.csproj;$(MSBuildProjectDirectory)\..\ChillSharp.I18n\ChillSharp.I18n.csproj;$(MSBuildProjectDirectory)\..\ChillSharp.Schema\ChillSharp.Schema.csproj;$(MSBuildProjectDirectory)\..\ChillSharp.Mcp\ChillSharp.Mcp.csproj;$(MSBuildProjectDirectory)\..\ChillSharp.Attachment\ChillSharp.Attachment.csproj;$(MSBuildProjectDirectory)\..\ChillSharp.AspNetCore\ChillSharp.AspNetCore.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);GeneratePackageOnBuild=false" />
    </Target>

    <Target Name="IncludeBuiltinModuleOutputs" DependsOnTargets="BuildBuiltinModuleProjects">
        <ItemGroup>
            <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\..\ChillSharp.Schema.Abstractions\bin\$(Configuration)\$(TargetFramework)\ChillSharp.Schema.Abstractions.dll" />
            <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\..\ChillSharp.Auth\bin\$(Configuration)\$(TargetFramework)\ChillSharp.Auth.dll" />
            <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\..\ChillSharp.I18n\bin\$(Configuration)\$(TargetFramework)\ChillSharp.I18n.dll" />
            <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\..\ChillSharp.Schema\bin\$(Configuration)\$(TargetFramework)\ChillSharp.Schema.dll" />
            <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\..\ChillSharp.Mcp\bin\$(Configuration)\$(TargetFramework)\ChillSharp.Mcp.dll" />
            <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\..\ChillSharp.Attachment\bin\$(Configuration)\$(TargetFramework)\ChillSharp.Attachment.dll" />
            <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\..\ChillSharp.AspNetCore\bin\$(Configuration)\$(TargetFramework)\ChillSharp.AspNetCore.dll" />
        </ItemGroup>
    </Target>

</Project>
