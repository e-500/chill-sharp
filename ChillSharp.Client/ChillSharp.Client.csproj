<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<Title>ChillSharp Client library</Title>
		<Copyright>© 2025 Andrea Piovesan</Copyright>
		<PackageIcon>logo.png</PackageIcon>
		<RepositoryUrl>https://github.com/e-500/chill-sharp</RepositoryUrl>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IsPackable>true</IsPackable>
		<PackageOutputPath>C:\source\repos-vs22\NuGetLocalPackages\</PackageOutputPath>
		<Description>Lightweight client for interacting with the ChillSharp API. ChillSharp is a powerful .NET library designed to streamline the management of complex data models and accelerate the development of web APIs. Built on top of Entity Framework Core, ChillSharp abstracts the complexity of database interactions while providing a lightweight, web-friendly layer for querying, creating, updating, and deleting entities through Data Transfer Objects (DTOs).</Description>
		<Version>1.0.122</Version>
		<Authors>Andrea Piovesan</Authors>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeClientDependencyOutputs</TargetsForTfmSpecificBuildOutput>
	</PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE.md" Link="LICENSE.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
	<None Include="..\logo\logo.png">
		<Pack>True</Pack>
		<PackagePath>\</PackagePath>
	</None>
    <None Include="..\README.md" Link="README.md">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChillSharp.Schema.Abstractions\ChillSharp.Schema.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ChillSharp.Auth\ChillSharp.Auth.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\ChillSharp.I18n\ChillSharp.I18n.csproj" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="BuildClientDependencyProjects">
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\ChillSharp.Schema.Abstractions\ChillSharp.Schema.Abstractions.csproj;$(MSBuildProjectDirectory)\..\ChillSharp.Auth\ChillSharp.Auth.csproj;$(MSBuildProjectDirectory)\..\ChillSharp.I18n\ChillSharp.I18n.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);GeneratePackageOnBuild=false" />
  </Target>

  <Target Name="IncludeClientDependencyOutputs" DependsOnTargets="BuildClientDependencyProjects">
    <ItemGroup>
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\..\ChillSharp.Schema.Abstractions\bin\$(Configuration)\$(TargetFramework)\ChillSharp.Schema.Abstractions.dll" />
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\..\ChillSharp.Auth\bin\$(Configuration)\$(TargetFramework)\ChillSharp.Auth.dll" />
      <BuildOutputInPackage Include="$(MSBuildProjectDirectory)\..\ChillSharp.I18n\bin\$(Configuration)\$(TargetFramework)\ChillSharp.I18n.dll" />
    </ItemGroup>
  </Target>

</Project>
